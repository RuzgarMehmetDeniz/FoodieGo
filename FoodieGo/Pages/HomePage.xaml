<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:FoodieGo.Helpers"
             x:Class="FoodieGo.Pages.HomePage"
             BackgroundColor="{StaticResource Background}"
             Title="Ana Sayfa">

    <ScrollView>
        <VerticalStackLayout Padding="16,16,16,24" Spacing="18">

            <!-- Üst bilgi satırı -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Label Grid.Column="0"
                       Text="{x:Static helpers:IconFont.LocationOn}"
                       FontFamily="MaterialSymbols"
                       FontSize="20"
                       TextColor="{StaticResource Primary}"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="Ev • Kurtköy, İstanbul"
                       FontFamily="OpenSansSemibold"
                       FontSize="15"
                       TextColor="{StaticResource TextPrimary}"
                       VerticalOptions="Center" />
                <Label Grid.Column="2"
                       Text="{x:Static helpers:IconFont.Notifications}"
                       FontFamily="MaterialSymbols"
                       FontSize="22"
                       TextColor="{StaticResource TextPrimary}"
                       VerticalOptions="Center" />
            </Grid>

            <!-- Arama çubuğu -->
            <Border StrokeShape="RoundRectangle 24"
                    Stroke="{StaticResource Divider}"
                    BackgroundColor="{StaticResource CardBackground}"
                    Padding="16,0"
                    HeightRequest="48">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Grid.Column="0"
                           Text="{x:Static helpers:IconFont.Search}"
                           FontFamily="MaterialSymbols"
                           FontSize="20"
                           TextColor="{StaticResource TextSecondary}"
                           VerticalOptions="Center" />
                    <Entry Grid.Column="1"
                           Placeholder="Ürün, kategori veya marka ara"
                           PlaceholderColor="{StaticResource TextSecondary}"
                           TextColor="{StaticResource TextPrimary}"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Kampanya banner'ları - yatay kaydırılabilir -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="12">

                    <Border StrokeShape="RoundRectangle 18"
                            BackgroundColor="{StaticResource Primary}"
                            WidthRequest="240" HeightRequest="130"
                            Padding="16">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDiscountsBannerTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                            <Border StrokeShape="RoundRectangle 20"
                                    BackgroundColor="{StaticResource DiscountRed}"
                                    Padding="10,4"
                                    HorizontalOptions="Start">
                                <Label Text="%30 İndirim" TextColor="White" FontSize="12" FontFamily="OpenSansSemibold" />
                            </Border>
                            <Label Text="Haftanın Fırsatları" TextColor="White" FontSize="19" FontFamily="OpenSansSemibold" />
                        </VerticalStackLayout>
                    </Border>

                    <Border StrokeShape="RoundRectangle 18"
                            BackgroundColor="{StaticResource SecondaryDarkText}"
                            WidthRequest="240" HeightRequest="130"
                            Padding="16">
                        <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                            <Border StrokeShape="RoundRectangle 20"
                                    BackgroundColor="{StaticResource CardBackground}"
                                    Padding="10,4"
                                    HorizontalOptions="Start">
                                <Label Text="Taze" TextColor="{StaticResource SecondaryDarkText}" FontSize="12" FontFamily="OpenSansSemibold" />
                            </Border>
                            <Label Text="Meyve &amp; Sebzede Taptaze" TextColor="White" FontSize="18" FontFamily="OpenSansSemibold" />
                        </VerticalStackLayout>
                    </Border>

                </HorizontalStackLayout>
            </ScrollView>

            <!-- Kategoriler başlığı -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="Kategoriler" FontFamily="OpenSansSemibold" FontSize="18" TextColor="{StaticResource TextPrimary}" />
                <Label Grid.Column="1" Text="Tümünü Gör" FontSize="14" TextColor="{StaticResource Primary}" />
            </Grid>

            <!-- Kategori kısayolları - yatay -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="18">

                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center" WidthRequest="70">
                        <Border StrokeShape="RoundRectangle 32" BackgroundColor="{StaticResource Secondary}" WidthRequest="64" HeightRequest="64">
                            <Label Text="🍎" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Meyve&amp;Sebze" FontSize="12" HorizontalTextAlignment="Center" TextColor="{StaticResource TextPrimary}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center" WidthRequest="70">
                        <Border StrokeShape="RoundRectangle 32" BackgroundColor="{StaticResource Secondary}" WidthRequest="64" HeightRequest="64">
                            <Label Text="🥛" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Süt Ürünleri" FontSize="12" HorizontalTextAlignment="Center" TextColor="{StaticResource TextPrimary}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center" WidthRequest="70">
                        <Border StrokeShape="RoundRectangle 32" BackgroundColor="{StaticResource Secondary}" WidthRequest="64" HeightRequest="64">
                            <Label Text="🥖" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Fırın" FontSize="12" HorizontalTextAlignment="Center" TextColor="{StaticResource TextPrimary}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center" WidthRequest="70">
                        <Border StrokeShape="RoundRectangle 32" BackgroundColor="{StaticResource Secondary}" WidthRequest="64" HeightRequest="64">
                            <Label Text="🥤" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="İçecek" FontSize="12" HorizontalTextAlignment="Center" TextColor="{StaticResource TextPrimary}" />
                    </VerticalStackLayout>

                </HorizontalStackLayout>
            </ScrollView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>