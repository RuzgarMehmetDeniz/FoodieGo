<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:FoodieGo.Helpers"
    x:Class="FoodieGo.Pages.ProductsPage"
    BackgroundColor="{StaticResource Background}"
    Shell.NavBarIsVisible="False"
    Title="">

    <Grid RowDefinitions="Auto,*">

        <!-- ÜST BAŞLIK BAR -->
        <Border Grid.Row="0" 
                Padding="16" 
                BackgroundColor="{StaticResource CardBackground}" 
                StrokeThickness="0">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" 
                       Text="Ürün Kataloğu" 
                       FontFamily="OpenSansSemibold" 
                       FontSize="18" 
                       TextColor="{StaticResource TextPrimary}"
                       VerticalOptions="Center" />

                <Label x:Name="ProductCountLabel"
                       Grid.Column="1"
                       Text="0 Ürün"
                       FontSize="13"
                       FontFamily="OpenSansSemibold"
                       TextColor="{StaticResource TextSecondary}"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- DİNAMİK ÜRÜN LİSTESİ -->
        <CollectionView x:Name="ProductsList" 
                        Grid.Row="1">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" 
                                 Span="2" 
                                 HorizontalItemSpacing="12" 
                                 VerticalItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="6">
                        <Border StrokeShape="RoundRectangle 16" 
                                BackgroundColor="{StaticResource CardBackground}" 
                                Stroke="{StaticResource Divider}"
                                Padding="12">

                            <VerticalStackLayout Spacing="8">
                                <!-- Ürün Görseli -->
                                <Border StrokeShape="RoundRectangle 12"
        BackgroundColor="{StaticResource Secondary}"
        HeightRequest="90"
        HorizontalOptions="Fill"
        Padding="0"
        Stroke="Transparent">
                                    <Image
        Source="{Binding Image}"
        Aspect="AspectFill"
        HeightRequest="90" />
                                </Border>

                                <!-- Ürün Adı -->
                                <Label Text="{Binding Name}" 
                                       FontFamily="OpenSansSemibold" 
                                       FontSize="14" 
                                       LineBreakMode="TailTruncation"
                                       TextColor="{StaticResource TextPrimary}" />

                                <!-- Fiyat ve Ekle Butonu -->
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="End">
                                    <Label Grid.Column="0" 
                                           Text="{Binding Price, StringFormat='{}{0:C2}'}" 
                                           TextColor="{StaticResource Primary}" 
                                           FontFamily="OpenSansSemibold" 
                                           FontSize="15" 
                                           VerticalOptions="Center" />

                                    <Button Grid.Column="1"
                                            Text="+"
                                            FontSize="18"
                                            FontAttributes="Bold"
                                            TextColor="White"
                                            BackgroundColor="{StaticResource Primary}"
                                            CornerRadius="14"
                                            WidthRequest="32"
                                            HeightRequest="32"
                                            Padding="0"
                                            VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- BOŞ LİSTE GÖRÜNÜMÜ -->
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Padding="20">
                    <Label Text="Bu kategoride henüz ürün bulunmuyor." 
                           TextColor="{StaticResource TextSecondary}" 
                           FontSize="14" 
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

        </CollectionView>

    </Grid>

</ContentPage>