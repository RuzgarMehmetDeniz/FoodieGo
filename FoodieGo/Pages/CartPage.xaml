<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodieGo.Pages.CartPage"
             BackgroundColor="{StaticResource Background}"
             Title="Sepet">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16">

        <Label Grid.Row="0" Text="Sepet" FontFamily="OpenSansSemibold" FontSize="22"
               TextColor="{StaticResource TextPrimary}" Margin="0,0,0,12" />

        <CollectionView Grid.Row="1" x:Name="CartList">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 16"
                            BackgroundColor="{StaticResource CardBackground}"
                            Stroke="{StaticResource Divider}"
                            Padding="12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource Secondary}" WidthRequest="56" HeightRequest="56">
                                <Label Text="{Binding Emoji}" FontSize="26" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="{Binding Price, StringFormat='{0:0.00} TL'}" FontSize="14" TextColor="{StaticResource Primary}" />
                            </VerticalStackLayout>

                            <Grid Grid.Column="2" ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                <Border Grid.Column="0" StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource Secondary}" WidthRequest="28" HeightRequest="28">
                                    <Label Text="-" FontSize="16" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Column="1" Text="{Binding Quantity}" FontSize="15" FontFamily="OpenSansSemibold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                <Border Grid.Column="2" StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource Primary}" WidthRequest="28" HeightRequest="28">
                                    <Label Text="+" FontSize="16" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="2" StrokeShape="RoundRectangle 16" BackgroundColor="{StaticResource Primary}" Padding="16" Margin="0,12,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Toplam" FontSize="13" TextColor="#D7EDE1" />
                    <Label x:Name="TotalLabel" FontFamily="OpenSansSemibold" FontSize="20" TextColor="White" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Siparişi Tamamla" BackgroundColor="White" TextColor="{StaticResource Primary}"
                        FontFamily="OpenSansSemibold" CornerRadius="10" VerticalOptions="Center" />
            </Grid>
        </Border>

    </Grid>

</ContentPage>