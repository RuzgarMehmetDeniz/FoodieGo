<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:FoodieGo.Helpers"
             x:Class="FoodieGo.Pages.DiscountsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8F9FF"
             Title="İndirimler">

    <Grid RowDefinitions="*, Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="16" Padding="16,16,16,24">

                <!-- SAYFA BAŞLIĞI -->
                <VerticalStackLayout Spacing="2" Margin="0,0,0,4">
                    <Label Text="İndirimler" FontFamily="InterBold" FontSize="28" TextColor="#121C2A" />
                    <Label Text="Sana özel fırsatları kaçırma" FontFamily="Inter" FontSize="15" TextColor="#3C4A42" />
                </VerticalStackLayout>

                <!-- BANNER'LAR BURAYA KOD İLE EKLENECEK -->
                <!-- BANNER'LAR: liste + şablon -->
                <VerticalStackLayout x:Name="BannerContainer"
                     Spacing="16"
                     BindableLayout.ItemsSource="{Binding .}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>

                            <!-- TEK BİR BANNER'IN TASARIMI -->
                            <Border StrokeShape="RoundRectangle 24"
        Stroke="Transparent"
        Padding="0"
        HeightRequest="130">

                                <!-- Katmanlar üst üste: görsel → koyu katman → içerik -->
                                <Grid>

                                    <!-- 1. Katman: arka plan görseli -->
                                    <Image Source="{Binding Image}"
               Aspect="AspectFill" />

                                    <!-- 2. Katman: yazı okunsun diye yarı saydam koyu örtü -->
                                    <BoxView Color="Black" Opacity="0.35" />

                                    <!-- 3. Katman: içerik (oran + metinler) -->
                                    <Grid ColumnDefinitions="120, *">

                                        <!-- Sol: indirim oranı -->
                                        <Grid Grid.Column="0" BackgroundColor="#33000000">
                                            <Label Text="{Binding Percentage, StringFormat='%{0}'}"
                       FontFamily="InterBold"
                       FontSize="34"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                                        </Grid>

                                        <!-- Sağ: başlık + açıklama + tarih -->
                                        <VerticalStackLayout Grid.Column="1" Padding="16" Spacing="4" VerticalOptions="Center">
                                            <Label Text="{Binding Title}"
                       FontFamily="InterBold" FontSize="18" TextColor="White" />
                                            <Label Text="{Binding Description}"
                       FontFamily="Inter" FontSize="13" TextColor="White" />
                                            <Label Text="{Binding EndDate, StringFormat='Son gün: {0}'}"
                       FontFamily="Inter" FontSize="12" TextColor="White" Opacity="0.8" />
                                        </VerticalStackLayout>

                                    </Grid>

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ALT NAVİGASYON (sabit) -->
        <Border Grid.Row="1" BackgroundColor="White" Stroke="Transparent" Padding="0,8" HeightRequest="80">
            <Grid ColumnDefinitions="*, *, *, *" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                    <Label Text="{x:Static helpers:IconFont.Home}" FontFamily="MaterialSymbols" FontSize="24" TextColor="#3C4A42" HorizontalOptions="Center" />
                    <Label Text="Ana Sayfa" FontFamily="Inter" FontSize="10" TextColor="#3C4A42" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                    <Label Text="{x:Static helpers:IconFont.GridView}" FontFamily="MaterialSymbols" FontSize="24" TextColor="#3C4A42" HorizontalOptions="Center" />
                    <Label Text="Kategoriler" FontFamily="Inter" FontSize="10" TextColor="#3C4A42" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                    <Label Text="{x:Static helpers:IconFont.ShoppingCart}" FontFamily="MaterialSymbols" FontSize="24" TextColor="#3C4A42" HorizontalOptions="Center" />
                    <Label Text="Sepet" FontFamily="Inter" FontSize="10" TextColor="#3C4A42" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center">
                    <Label Text="{x:Static helpers:IconFont.Person}" FontFamily="MaterialSymbols" FontSize="24" TextColor="#3C4A42" HorizontalOptions="Center" />
                    <Label Text="Profil" FontFamily="Inter" FontSize="10" TextColor="#3C4A42" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Border>

    </Grid>

</ContentPage>

