<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:FoodieGo.Helpers"
             x:Class="FoodieGo.Pages.OrdersPage"
             BackgroundColor="{StaticResource Background}"
             Title="Siparişlerim"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*" Padding="16">

        <!-- Başlık -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,16">
            <Border Grid.Column="0" StrokeShape="RoundRectangle 18" BackgroundColor="{StaticResource CardBackground}" WidthRequest="40" HeightRequest="40" Padding="0">
                <Label Text="{x:Static helpers:IconFont.ArrowBack}" FontFamily="MaterialSymbols" FontSize="20"
                       TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="Siparişlerim" FontFamily="OpenSansSemibold" FontSize="22" TextColor="{StaticResource TextPrimary}" />
                <Label x:Name="OrderCountLabel" Text="0 sipariş" FontSize="13" TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>
        </Grid>

        <!-- Sipariş listesi -->
        <CollectionView Grid.Row="1" x:Name="OrdersList">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 16" BackgroundColor="{StaticResource CardBackground}"
                            Stroke="{StaticResource Divider}" Padding="16">
                        <VerticalStackLayout Spacing="12">

                            <!-- Üst satır: Sipariş no + Tarih -->
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding OrderId, StringFormat='Sipariş #{0}'}"
                                           FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="{Binding OrderDate}" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>

                                <!-- Ürün adedi rozeti -->
                                <Border Grid.Column="1" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource Secondary}"
                                        Padding="10,5" VerticalOptions="Start">
                                    <Label Text="{Binding ItemCount, StringFormat='{0} ürün'}" FontSize="12"
                                           FontFamily="OpenSansSemibold" TextColor="{StaticResource Primary}" />
                                </Border>
                            </Grid>

                            <!-- Ayırıcı çizgi -->
                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Divider}" />

                            <!-- Alt satır: Toplam -->
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Toplam Tutar" FontSize="13" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding Total, StringFormat='{0:0.00} TL'}"
                                       FontFamily="OpenSansSemibold" FontSize="18" TextColor="{StaticResource Primary}" />
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Boş durum -->
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Padding="20">
                    <Label Text="{x:Static helpers:IconFont.Receipt}" FontFamily="MaterialSymbols" FontSize="42"
                           TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                    <Label Text="Henüz siparişin yok." TextColor="{StaticResource TextSecondary}" FontSize="14"
                           HorizontalOptions="Center" />
                    <Label Text="Sepetinden bir sipariş vererek başlayabilirsin." TextColor="{StaticResource TextSecondary}"
                           FontSize="12" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

    </Grid>
</ContentPage>
