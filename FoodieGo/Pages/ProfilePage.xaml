<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:FoodieGo.Helpers"
             x:Class="FoodieGo.Pages.ProfilePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8F9FF"
             Title="Profil">

    <Grid RowDefinitions="*, Auto">

        <!-- KAYDIRILABİLİR İÇERİK -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="20" Padding="16,20,16,24">

                <!-- PROFİL BAŞLIĞI -->
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <!-- Avatar -->
                    <Border WidthRequest="90" HeightRequest="90"
                            StrokeShape="RoundRectangle 45"
                            Stroke="Transparent"
                            BackgroundColor="#006C49"
                            HorizontalOptions="Center">
                        <Label Text="{x:Static helpers:IconFont.Person}"
                               FontFamily="MaterialSymbols"
                               FontSize="48"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <Label Text="Rüzgar Deniz"
                           FontFamily="InterBold" FontSize="22" TextColor="#121C2A"
                           HorizontalOptions="Center" />
                    <Label Text="ruzgardeniz@gmail.com"
                           FontFamily="Inter" FontSize="14" TextColor="#3C4A42"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- HESAP BAŞLIĞI -->
                <Label Text="Hesabım" FontFamily="InterBold" FontSize="16" TextColor="#121C2A" Margin="4,4,0,0" />

                <!-- HESAP MENÜ KARTI -->
                <Border BackgroundColor="White" StrokeShape="RoundRectangle 16" Stroke="Transparent" Padding="0">
                    <VerticalStackLayout Spacing="0">

                        <!-- Siparişlerim -->
                        <Grid ColumnDefinitions="Auto, *, Auto" Padding="16,14" ColumnSpacing="14">
                            <Label Grid.Column="0" Text="{x:Static helpers:IconFont.Receipt}" FontFamily="MaterialSymbols" FontSize="22" TextColor="#006C49" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Siparişlerim" FontFamily="Inter" FontSize="15" TextColor="#121C2A" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="{x:Static helpers:IconFont.ChevronRight}" FontFamily="MaterialSymbols" FontSize="22" TextColor="#6C7A71" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#EFF4FF" />

                        <!-- Adreslerim -->
                        <Grid ColumnDefinitions="Auto, *, Auto" Padding="16,14" ColumnSpacing="14">
                            <Label Grid.Column="0" Text="{x:Static helpers:IconFont.LocationOn}" FontFamily="MaterialSymbols" FontSize="22" TextColor="#006C49" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Adreslerim" FontFamily="Inter" FontSize="15" TextColor="#121C2A" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="{x:Static helpers:IconFont.ChevronRight}" FontFamily="MaterialSymbols" FontSize="22" TextColor="#6C7A71" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#EFF4FF" />

                        <!-- Ödeme Yöntemlerim -->
                        <Grid ColumnDefinitions="Auto, *, Auto" Padding="16,14" ColumnSpacing="14">
                            <Label Grid.Column="0" Text="{x:Static helpers:IconFont.CreditCard}" FontFamily="MaterialSymbols" FontSize="22" TextColor="#006C49" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Ödeme Yöntemlerim" FontFamily="Inter" FontSize="15" TextColor="#121C2A" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="{x:Static helpers:IconFont.ChevronRight}" FontFamily="MaterialSymbols" FontSize="22" TextColor="#6C7A71" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#EFF4FF" />

                        <!-- Favorilerim -->
                        <Grid ColumnDefinitions="Auto, *, Auto" Padding="16,14" ColumnSpacing="14">
                            <Label Grid.Column="0" Text="{x:Static helpers:IconFont.Favorite}" FontFamily="MaterialSymbols" FontSize="22" TextColor="#006C49" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Favorilerim" FontFamily="Inter" FontSize="15" TextColor="#121C2A" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="{x:Static helpers:IconFont.ChevronRight}" FontFamily="MaterialSymbols" FontSize="22" TextColor="#6C7A71" VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- AYARLAR BAŞLIĞI -->
                <Label Text="Ayarlar" FontFamily="InterBold" FontSize="16" TextColor="#121C2A" Margin="4,4,0,0" />

                <!-- AYARLAR MENÜ KARTI -->
                <Border BackgroundColor="White" StrokeShape="RoundRectangle 16" Stroke="Transparent" Padding="0">
                    <VerticalStackLayout Spacing="0">

                        <!-- Bildirimler -->
                        <Grid ColumnDefinitions="Auto, *, Auto" Padding="16,14" ColumnSpacing="14">
                            <Label Grid.Column="0" Text="{x:Static helpers:IconFont.Notifications}" FontFamily="MaterialSymbols" FontSize="22" TextColor="#006C49" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Bildirimler" FontFamily="Inter" FontSize="15" TextColor="#121C2A" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="{x:Static helpers:IconFont.ChevronRight}" FontFamily="MaterialSymbols" FontSize="22" TextColor="#6C7A71" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#EFF4FF" />

                        <!-- Yardım & Destek -->
                        <Grid ColumnDefinitions="Auto, *, Auto" Padding="16,14" ColumnSpacing="14">
                            <Label Grid.Column="0" Text="{x:Static helpers:IconFont.Help}" FontFamily="MaterialSymbols" FontSize="22" TextColor="#006C49" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Yardım &amp; Destek" FontFamily="Inter" FontSize="15" TextColor="#121C2A" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="{x:Static helpers:IconFont.ChevronRight}" FontFamily="MaterialSymbols" FontSize="22" TextColor="#6C7A71" VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- ÇIKIŞ BUTONU -->
                <Border BackgroundColor="White" StrokeShape="RoundRectangle 16" Stroke="Transparent" Padding="0" Margin="0,4,0,0">
                    <Grid ColumnDefinitions="Auto, *" Padding="16,14" ColumnSpacing="14">
                        <Label Grid.Column="0" Text="{x:Static helpers:IconFont.Logout}" FontFamily="MaterialSymbols" FontSize="22" TextColor="#BA1A1A" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Çıkış Yap" FontFamily="InterBold" FontSize="15" TextColor="#BA1A1A" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- SÜRÜM BİLGİSİ -->
                <Label Text="FoodieGo v1.0.0" FontFamily="Inter" FontSize="12" TextColor="#6C7A71" HorizontalOptions="Center" Margin="0,8,0,0" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- ALT NAVİGASYON (Profil aktif) -->
        <Border Grid.Row="1" BackgroundColor="White" Stroke="Transparent" Padding="0,8" HeightRequest="80">
            <Grid ColumnDefinitions="*, *, *, *" VerticalOptions="Center">
                
                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                    <Label Text="{x:Static helpers:IconFont.Home}" FontFamily="MaterialSymbols" FontSize="24" TextColor="#3C4A42" HorizontalOptions="Center" />
                    <Label Text="Ana Sayfa" FontFamily="Inter" FontSize="10" TextColor="#3C4A42" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCategoriesTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="{x:Static helpers:IconFont.GridView}" FontFamily="MaterialSymbols" FontSize="24" TextColor="#3C4A42" HorizontalOptions="Center" />
                    <Label Text="Kategoriler" FontFamily="Inter" FontSize="10" TextColor="#3C4A42" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                    <Label Text="{x:Static helpers:IconFont.ShoppingCart}" FontFamily="MaterialSymbols" FontSize="24" TextColor="#3C4A42" HorizontalOptions="Center" />
                    <Label Text="Sepet" FontFamily="Inter" FontSize="10" TextColor="#3C4A42" HorizontalOptions="Center" />
                </VerticalStackLayout>
                
                <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center">
                    <Label Text="{x:Static helpers:IconFont.Person}" FontFamily="MaterialSymbols" FontSize="24" TextColor="#006C49" HorizontalOptions="Center" />
                    <Label Text="Profil" FontFamily="InterBold" FontSize="10" TextColor="#006C49" HorizontalOptions="Center" />
                </VerticalStackLayout>
                
            </Grid>
        </Border>

    </Grid>

</ContentPage>

