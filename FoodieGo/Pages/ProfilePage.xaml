<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:FoodieGo.Helpers"
             x:Class="FoodieGo.Pages.ProfilePage"
             BackgroundColor="{StaticResource Background}"
             Title="Profil">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Kullanıcı bilgisi -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Grid.Column="0" StrokeShape="RoundRectangle 32" BackgroundColor="{StaticResource Secondary}" WidthRequest="64" HeightRequest="64">
                    <Label Text="{x:Static helpers:IconFont.Person}" FontFamily="MaterialSymbols" FontSize="30"
                           TextColor="{StaticResource SecondaryDarkText}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label Text="Mehmet Deniz" FontFamily="OpenSansSemibold" FontSize="18" TextColor="{StaticResource TextPrimary}" />
                    <Label Text="mehmet@example.com" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
            </Grid>

            <!-- Menü listesi -->
            <VerticalStackLayout Spacing="10">

                <Border StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource Divider}" Padding="14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Label Grid.Column="0" Text="{x:Static helpers:IconFont.Receipt}" FontFamily="MaterialSymbols" FontSize="20" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Siparişlerim" FontSize="15" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="{x:Static helpers:IconFont.ChevronRight}" FontFamily="MaterialSymbols" FontSize="18" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource Divider}" Padding="14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Label Grid.Column="0" Text="{x:Static helpers:IconFont.LocationCity}" FontFamily="MaterialSymbols" FontSize="20" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Adreslerim" FontSize="15" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="{x:Static helpers:IconFont.ChevronRight}" FontFamily="MaterialSymbols" FontSize="18" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource Divider}" Padding="14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Label Grid.Column="0" Text="{x:Static helpers:IconFont.CreditCard}" FontFamily="MaterialSymbols" FontSize="20" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Ödeme Yöntemlerim" FontSize="15" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="{x:Static helpers:IconFont.ChevronRight}" FontFamily="MaterialSymbols" FontSize="18" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource Divider}" Padding="14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Label Grid.Column="0" Text="{x:Static helpers:IconFont.Favorite}" FontFamily="MaterialSymbols" FontSize="20" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Favorilerim" FontSize="15" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="{x:Static helpers:IconFont.ChevronRight}" FontFamily="MaterialSymbols" FontSize="18" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource Divider}" Padding="14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Label Grid.Column="0" Text="{x:Static helpers:IconFont.Settings}" FontFamily="MaterialSymbols" FontSize="20" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Ayarlar" FontSize="15" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="{x:Static helpers:IconFont.ChevronRight}" FontFamily="MaterialSymbols" FontSize="18" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource Divider}" Padding="14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Label Grid.Column="0" Text="{x:Static helpers:IconFont.Help}" FontFamily="MaterialSymbols" FontSize="20" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Yardım" FontSize="15" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="{x:Static helpers:IconFont.ChevronRight}" FontFamily="MaterialSymbols" FontSize="18" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource DiscountRed}" Padding="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Label Grid.Column="0" Text="{x:Static helpers:IconFont.Logout}" FontFamily="MaterialSymbols" FontSize="20" TextColor="{StaticResource DiscountRed}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Çıkış Yap" FontSize="15" TextColor="{StaticResource DiscountRed}" VerticalOptions="Center" />
                    </Grid>
                </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>