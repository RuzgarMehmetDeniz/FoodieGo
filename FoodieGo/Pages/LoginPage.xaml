<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:FoodieGo.Helpers"
             x:Class="FoodieGo.Pages.LoginPage"
             BackgroundColor="{StaticResource Background}"
             Title="Giriş Yap"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,60,24,24" Spacing="20">

            <VerticalStackLayout Spacing="4">
                <Label Text="Tekrar Hoş Geldin" FontFamily="OpenSansSemibold" FontSize="26" TextColor="{StaticResource TextPrimary}" />
                <Label Text="Devam etmek için giriş yap" FontSize="14" TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="E-posta" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                <Border StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource Divider}" Padding="14,10">
                    <Entry x:Name="EmailEntry" Placeholder="mehmet@example.com" Keyboard="Email" FontSize="15" TextColor="{StaticResource TextPrimary}" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Şifre" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                <Border StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource Divider}" Padding="14,10">
                    <Entry x:Name="PasswordEntry" Placeholder="Şifren" IsPassword="True" FontSize="15" TextColor="{StaticResource TextPrimary}" />
                </Border>
            </VerticalStackLayout>

            <Label x:Name="ErrorLabel" Text="" FontSize="13" TextColor="Red" IsVisible="False" />

            <Border StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource Primary}" Padding="0" HeightRequest="52" Margin="0,10,0,0">
                <Grid>
                    <Label Text="Giriş Yap" TextColor="White" FontFamily="OpenSansSemibold" FontSize="16"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLoginTapped" />
                    </Grid.GestureRecognizers>
                </Grid>
            </Border>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,8,0,0">
                <Label Text="Hesabın yok mu?" FontSize="14" TextColor="{StaticResource TextSecondary}" />
                <Label Text="Kayıt ol" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{StaticResource Primary}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGoToRegisterTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
