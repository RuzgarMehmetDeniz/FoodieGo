<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:FoodieGo.Helpers"
             x:Class="FoodieGo.Pages.StatisticsPage"
             BackgroundColor="{StaticResource Background}"
             Title="İstatistikler"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="16,16,16,24" Spacing="20">

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border Grid.Column="0" StrokeShape="RoundRectangle 18" BackgroundColor="{StaticResource CardBackground}" WidthRequest="40" HeightRequest="40" Padding="0">
                    <Label Text="{x:Static helpers:IconFont.ArrowBack}" FontFamily="MaterialSymbols" FontSize="20"
                           TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="İstatistikler" FontFamily="OpenSansSemibold" FontSize="22" TextColor="{StaticResource TextPrimary}" />
                    <Label Text="Bu ayki alışveriş özetin" FontSize="14" TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
            </Grid>

            <!-- KPI kartları: 2x2 -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">

                <Border Grid.Row="0" Grid.Column="0" StrokeShape="RoundRectangle 16"
                        BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource Divider}" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Border StrokeShape="RoundRectangle 20" BackgroundColor="{StaticResource Secondary}"
                                WidthRequest="40" HeightRequest="40" Padding="0" HorizontalOptions="Start">
                            <Label Text="{x:Static helpers:IconFont.Receipt}" FontFamily="MaterialSymbols" FontSize="20"
                                   TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="14" FontFamily="OpenSansSemibold" FontSize="22" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="Toplam Sipariş" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" StrokeShape="RoundRectangle 16"
                        BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource Divider}" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Border StrokeShape="RoundRectangle 20" BackgroundColor="{StaticResource Secondary}"
                                WidthRequest="40" HeightRequest="40" Padding="0" HorizontalOptions="Start">
                            <Label Text="{x:Static helpers:IconFont.AttachMoney}" FontFamily="MaterialSymbols" FontSize="20"
                                   TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="2.148,50 TL" FontFamily="OpenSansSemibold" FontSize="22" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="Toplam Harcama" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" StrokeShape="RoundRectangle 16"
                        BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource Divider}" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Border StrokeShape="RoundRectangle 20" BackgroundColor="{StaticResource Secondary}"
                                WidthRequest="40" HeightRequest="40" Padding="0" HorizontalOptions="Start">
                            <Label Text="{x:Static helpers:IconFont.Star}" FontFamily="MaterialSymbols" FontSize="20"
                                   TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Meyve&amp;Sebze" FontFamily="OpenSansSemibold" FontSize="18" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="Favori Kategori" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" StrokeShape="RoundRectangle 16"
                        BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource Divider}" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Border StrokeShape="RoundRectangle 20" BackgroundColor="{StaticResource Secondary}"
                                WidthRequest="40" HeightRequest="40" Padding="0" HorizontalOptions="Start">
                            <Label Text="{x:Static helpers:IconFont.ShoppingBasket}" FontFamily="MaterialSymbols" FontSize="20"
                                   TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="153,50 TL" FontFamily="OpenSansSemibold" FontSize="22" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="Ortalama Sepet" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <!-- Kategori dağılımı -->
            <VerticalStackLayout Spacing="12">
                <Label Text="Kategori Dağılımı" FontFamily="OpenSansSemibold" FontSize="18" TextColor="{StaticResource TextPrimary}" />

                <CollectionView x:Name="CategoryStatsList">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="{Binding Name}" FontSize="14" TextColor="{StaticResource TextPrimary}" />
                                    <Label Grid.Column="1" Text="{Binding Percentage, StringFormat='%{0}'}"
                                           FontFamily="OpenSansSemibold" FontSize="14" TextColor="{StaticResource Primary}" />
                                </Grid>
                                <Border StrokeShape="RoundRectangle 6" BackgroundColor="{StaticResource Secondary}" HeightRequest="10" Padding="0">
                                    <Border StrokeShape="RoundRectangle 6" BackgroundColor="{StaticResource Primary}"
                                            HeightRequest="10" HorizontalOptions="Start" WidthRequest="{Binding BarWidth}" />
                                </Border>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>