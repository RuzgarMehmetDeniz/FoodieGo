<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:FoodieGo.Helpers"
             x:Class="FoodieGo.Pages.StatisticsPage"
             BackgroundColor="{StaticResource Background}"
             Title="İstatistikler"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="16,16,16,24" Spacing="20">

            <!-- Başlık -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border Grid.Column="0" StrokeShape="RoundRectangle 18" BackgroundColor="{StaticResource CardBackground}" WidthRequest="40" HeightRequest="40" Padding="0">
                    <Label Text="{x:Static helpers:IconFont.ArrowBack}" FontFamily="MaterialSymbols" FontSize="20"
                           TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="İstatistikler" FontFamily="OpenSansSemibold" FontSize="22" TextColor="{StaticResource TextPrimary}" />
                    <Label Text="Veritabanından anlık özet" FontSize="14" TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
            </Grid>

            <!-- ANA KPI'LAR (case zorunlu) -->
            <Label Text="Genel Bakış" FontFamily="OpenSansSemibold" FontSize="16" TextColor="{StaticResource TextPrimary}" />
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">

                <Border Grid.Row="0" Grid.Column="0" StrokeShape="RoundRectangle 16"
                        BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource Divider}" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Border StrokeShape="RoundRectangle 20" BackgroundColor="{StaticResource Secondary}"
                                WidthRequest="40" HeightRequest="40" Padding="0" HorizontalOptions="Start">
                            <Label Text="{x:Static helpers:IconFont.ShoppingBasket}" FontFamily="MaterialSymbols" FontSize="20"
                                   TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label x:Name="TotalProductLabel" Text="0" FontFamily="OpenSansSemibold" FontSize="22" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="Toplam Ürün" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" StrokeShape="RoundRectangle 16"
                        BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource Divider}" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Border StrokeShape="RoundRectangle 20" BackgroundColor="{StaticResource Secondary}"
                                WidthRequest="40" HeightRequest="40" Padding="0" HorizontalOptions="Start">
                            <Label Text="{x:Static helpers:IconFont.Receipt}" FontFamily="MaterialSymbols" FontSize="20"
                                   TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label x:Name="CartItemCountLabel" Text="0" FontFamily="OpenSansSemibold" FontSize="22" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="Sepetteki Ürün Adedi" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" StrokeShape="RoundRectangle 16"
                        BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource Divider}" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Border StrokeShape="RoundRectangle 20" BackgroundColor="{StaticResource Secondary}"
                                WidthRequest="40" HeightRequest="40" Padding="0" HorizontalOptions="Start">
                            <Label Text="{x:Static helpers:IconFont.AttachMoney}" FontFamily="MaterialSymbols" FontSize="20"
                                   TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label x:Name="CartTotalLabel" Text="0,00 TL" FontFamily="OpenSansSemibold" FontSize="22" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="Sepet Toplamı" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" StrokeShape="RoundRectangle 16"
                        BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource Divider}" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Border StrokeShape="RoundRectangle 20" BackgroundColor="{StaticResource Secondary}"
                                WidthRequest="40" HeightRequest="40" Padding="0" HorizontalOptions="Start">
                            <Label Text="{x:Static helpers:IconFont.Star}" FontFamily="MaterialSymbols" FontSize="20"
                                   TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label x:Name="ActiveDiscountLabel" Text="0" FontFamily="OpenSansSemibold" FontSize="22" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="Aktif İndirim" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <!-- EK DETAYLAR -->
            <Label Text="Detaylar" FontFamily="OpenSansSemibold" FontSize="16" TextColor="{StaticResource TextPrimary}" />
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">

                <Border Grid.Row="0" Grid.Column="0" StrokeShape="RoundRectangle 16"
                        BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource Divider}" Padding="14">
                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="TotalCategoryLabel" Text="0" FontFamily="OpenSansSemibold" FontSize="18" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="Toplam Kategori" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" StrokeShape="RoundRectangle 16"
                        BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource Divider}" Padding="14">
                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="AvgPriceLabel" Text="0,00 TL" FontFamily="OpenSansSemibold" FontSize="18" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="Ortalama Ürün Fiyatı" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" StrokeShape="RoundRectangle 16"
                        BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource Divider}" Padding="14">
                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="DistinctCartLabel" Text="0" FontFamily="OpenSansSemibold" FontSize="18" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="Sepetteki Ürün Çeşidi" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" StrokeShape="RoundRectangle 16"
                        BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource Divider}" Padding="14">
                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="MaxDiscountLabel" Text="%0" FontFamily="OpenSansSemibold" FontSize="18" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="En Yüksek İndirim" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <!-- Kategori dağılımı (gerçek ürün sayısına göre) -->
            <VerticalStackLayout Spacing="12">
                <Label Text="Kategori Dağılımı (Ürün Sayısına Göre)" FontFamily="OpenSansSemibold" FontSize="16" TextColor="{StaticResource TextPrimary}" />

                <CollectionView x:Name="CategoryStatsList">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="{Binding Name}" FontSize="14" TextColor="{StaticResource TextPrimary}" />
                                    <Label Grid.Column="1" Text="{Binding ProductCount, StringFormat='{0} ürün'}"
                                           FontSize="13" TextColor="{StaticResource TextSecondary}" />
                                </Grid>
                                <Border StrokeShape="RoundRectangle 6" BackgroundColor="{StaticResource Secondary}" HeightRequest="10" Padding="0">
                                    <Border StrokeShape="RoundRectangle 6" BackgroundColor="{StaticResource Primary}"
                                            HeightRequest="10" HorizontalOptions="Start" WidthRequest="{Binding BarWidth}" />
                                </Border>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label x:Name="EmptyCategoryLabel" Text="Henüz kategori/ürün verisi yok." FontSize="14"
                       TextColor="{StaticResource TextSecondary}" IsVisible="False" HorizontalOptions="Center" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>