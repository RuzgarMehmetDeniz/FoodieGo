<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:FoodieGo.Helpers"
             x:Class="FoodieGo.Pages.SpinWheelPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8F9FF"
             Title="Çarkı Çevir">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- BAŞLIK -->
        <VerticalStackLayout Grid.Row="0" Spacing="2" Padding="16,20,16,0">
            <Label Text="Çarkı Çevir, Kazan!"
                   FontFamily="InterBold" FontSize="26" TextColor="#121C2A"
                   HorizontalOptions="Center" />
            <Label Text="Günde bir kez çevir, indirimini kap"
                   FontFamily="Inter" FontSize="14" TextColor="#3C4A42"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- ÇARK ALANI -->
        <Grid Grid.Row="1" VerticalOptions="Center" HorizontalOptions="Center">

            <!-- Çark görseli (dönecek olan) -->
            <Image x:Name="WheelImage"
                   Source="wheel.png"
                   WidthRequest="300"
                   HeightRequest="300"
                   Aspect="AspectFit" />

            <!-- Üstteki sabit gösterge (ok) -->
            <Label Text="▼"
                   FontSize="36"
                   TextColor="#BA1A1A"
                   HorizontalOptions="Center"
                   VerticalOptions="Start"
                   Margin="0,-10,0,0" />

        </Grid>

        <!-- ÇEVİR BUTONU + SONUÇ -->
        <VerticalStackLayout Grid.Row="2" Spacing="12" Padding="24,0,24,32">
            <Label x:Name="ResultLabel"
                   Text=""
                   FontFamily="InterBold" FontSize="18" TextColor="#006C49"
                   HorizontalOptions="Center" />
            <Button x:Name="SpinButton"
                    Text="ÇEVİR"
                    Clicked="OnSpinClicked"
                    BackgroundColor="#006C49" TextColor="White"
                    FontFamily="InterBold" FontSize="16"
                    CornerRadius="28" HeightRequest="56" />
        </VerticalStackLayout>

    </Grid>

</ContentPage>

