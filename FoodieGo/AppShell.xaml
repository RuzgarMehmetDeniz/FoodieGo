<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FoodieGo.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:FoodieGo.Pages"
    Title="FoodieGo">

    <TabBar>
        <ShellContent
            Title="Ana Sayfa"
            Icon="home.png"
            ContentTemplate="{DataTemplate pages:HomePage}"
            Route="HomePage" />

        <ShellContent
            Title="Kategoriler"
            Icon="grid.png"
            ContentTemplate="{DataTemplate pages:CategoriesPage}"
            Route="CategoriesPage" />

        <ShellContent
            Title="Sepet"
            Icon="cart.png"
            ContentTemplate="{DataTemplate pages:CartPage}"
            Route="CartPage" />

        <ShellContent
            Title="Profil"
            Icon="person.png"
            ContentTemplate="{DataTemplate pages:ProfilePage}"
            Route="ProfilePage" />
    </TabBar>

</Shell>